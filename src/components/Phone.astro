---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The `sizes` of the screenshot: its width at each breakpoint. */
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, sizes, class: className, loading = 'lazy' } = Astro.props;
---

<div class:list={['phone', className]}>
  <Image src={src} alt={alt} widths={[200, 320, 480, 640, 900]} sizes={sizes} loading={loading} />
</div>
