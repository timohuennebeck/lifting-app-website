---
import { LOCALES, pathOf, type Locale, type Page } from '@/i18n/locales';
import { STRINGS } from '@/i18n/strings';

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
---

<details class="language-switcher relative">
  <summary
    class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-full bg-sand px-3 text-[13px] font-semibold lg:h-11 lg:px-4 lg:text-sm"
    aria-label={STRINGS[locale.code].nav.language}
  >
    {locale.short}
    <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
      <path
        d="M1 1l4 4 4-4"
        stroke="currentColor"
        stroke-width="1.6"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </summary>
  <div class="absolute top-11 right-0 z-10 flex min-w-[220px] flex-col rounded-2xl bg-white p-1.5 shadow-[0_12px_40px_rgba(0,0,0,0.14)] lg:top-[52px]">
    {LOCALES.map((option) => (
      <a
        href={pathOf(option, page)}
        hreflang={option.code}
        lang={option.code}
        aria-current={option.code === locale.code ? 'true' : undefined}
        class:list={[
          'flex items-center justify-between gap-4 rounded-[10px] px-3 py-2.5 text-[15px]',
          option.code === locale.code && 'bg-paper font-semibold',
        ]}
      >
        <span>{option.label}</span>
        <span class="text-xs font-semibold text-faint">{option.short}</span>
      </a>
    ))}
  </div>
</details>

<script>
  // Close the menu on a click elsewhere or Escape; without JavaScript the summary toggles it.
  const menus = document.querySelectorAll<HTMLDetailsElement>('.language-switcher');
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') menus.forEach((menu) => (menu.open = false));
  });
</script>
