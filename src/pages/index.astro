---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Loqqa – Workout logger for iOS and Android"
  description="Import your plan, log every set and see every muscle level up."
>
  <main class="grid min-h-dvh place-items-center px-4">
    <div class="flex flex-col items-center gap-6 text-center">
      <img src="/favicon.svg" alt="" width="72" height="72" class="rounded-2xl" />
      <h1 class="text-4xl font-semibold tracking-tight">Loqqa</h1>
      <p class="max-w-sm text-muted">
        Workout logger for iOS and Android. Landing page coming soon.
      </p>
    </div>
  </main>
</Layout>
