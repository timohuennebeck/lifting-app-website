---
import { getEntry, render } from 'astro:content';

import { localePaths, type Locale } from '@/i18n/locales';
import LegalPage from '@/layouts/LegalPage.astro';
import { legalSections } from '@/lib/legal-sections';

export const getStaticPaths = localePaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('legal', `${locale.legal.toLowerCase()}/privacy`);
if (!entry) throw new Error(`No privacy for ${locale.legal}`);
const { Content } = await render(entry);
---

<LegalPage
  locale={locale}
  page="privacy"
  title={entry.data.title}
  updated={entry.data.updated}
  sections={legalSections(entry.body ?? '')}
  textLang={locale.legal === locale.code ? undefined : locale.legal}
>
  <Content />
</LegalPage>
