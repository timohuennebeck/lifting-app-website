---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import after from '@/assets/body-check/after.jpg';
import before from '@/assets/body-check/before.jpg';
import Phone from '@/components/Phone.astro';
import StoreButton from '@/components/StoreButton.astro';
import { localePaths, type Locale } from '@/i18n/locales';
import { STRINGS } from '@/i18n/strings';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = localePaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = STRINGS[locale.code];

// The app's own screens in this language (tools/app-screenshots).
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/app-screens/*/*.png');
const screen = async (name: string) =>
  (await shots[`/src/assets/app-screens/${locale.code}/${name}.png`]()).default;
const [plan, workout, history] = await Promise.all([
  screen('training'),
  screen('workout'),
  screen('exercise-history'),
]);
const features = [
  { ...t.features[0], src: plan, alt: t.screens.plan },
  { ...t.features[1], src: workout, alt: t.screens.workout },
  { ...t.features[2], src: history, alt: t.screens.history },
];
const featureSizes = '(min-width: 1024px) 227px, (min-width: 768px) 170px, 189px';
---

<Layout locale={locale} page="home" title={t.meta.title} description={t.meta.description}>
  <main>
    <section class="grid items-center gap-6 px-6 pt-6 lg:min-h-[720px] lg:grid-cols-2 lg:px-16 lg:pt-10">
      <div class="flex flex-col gap-5 lg:gap-7 lg:pb-20">
        <p class="text-[13px] font-semibold text-muted lg:text-sm">{t.hero.eyebrow}</p>
        <h1 class="text-5xl leading-[0.95] font-semibold tracking-[-0.05em] sm:text-7xl lg:text-[clamp(56px,7.2vw,92px)] lg:leading-[0.92] lg:tracking-[-0.055em]">
          {t.hero.title}
        </h1>
        <p class="text-[17px] leading-normal text-pretty text-lead lg:max-w-[460px] lg:text-xl">
          {t.hero.lead}
        </p>
        <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-3">
          <StoreButton class="h-[54px] px-[26px] text-base lg:h-14">{t.nav.download}</StoreButton>
          <p class="text-center text-[13px] text-muted lg:text-sm">{t.hero.note}</p>
        </div>
      </div>
      <div class="fan">
        <Phone
          src={plan}
          alt={t.screens.plan}
          class="fan-left"
          sizes="(min-width: 1024px) 240px, (min-width: 640px) 170px, 120px"
          loading="eager"
        />
        <Phone
          src={history}
          alt={t.screens.history}
          class="fan-right"
          sizes="(min-width: 1024px) 240px, (min-width: 640px) 170px, 120px"
          loading="eager"
        />
        <Phone
          src={workout}
          alt={t.screens.workout}
          class="fan-center"
          sizes="(min-width: 1024px) 285px, (min-width: 640px) 205px, 156px"
          loading="eager"
        />
      </div>
    </section>

    <section class="grid gap-10 px-6 pt-8 pb-16 md:grid-cols-3 md:gap-5 lg:px-16 lg:pt-10 lg:pb-24">
      {features.map((feature) => (
        <div class="flex flex-col gap-4 lg:gap-5">
          <div class="flex h-[300px] justify-center overflow-hidden rounded-3xl bg-sand pt-8 lg:h-[360px] lg:pt-10">
            <Phone
              src={feature.src}
              alt={feature.alt}
              sizes={featureSizes}
              class="[--h:422px] md:[--h:380px] lg:[--h:506px]"
            />
          </div>
          <div class="flex flex-col gap-1.5 px-1">
            <h2 class="text-[21px] font-semibold tracking-[-0.02em] lg:text-[22px]">
              {feature.title}
            </h2>
            <p class="text-base leading-normal text-copy">{feature.text}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="mx-3 grid gap-8 rounded-[28px] bg-ink px-5 pt-12 pb-7 text-paper lg:mx-6 lg:grid-cols-[5fr_7fr] lg:items-center lg:gap-14 lg:rounded-[32px] lg:px-16 lg:py-[88px]">
      <div class="flex flex-col gap-3.5 px-1 lg:gap-5 lg:px-0">
        <p class="text-[13px] font-semibold tracking-[0.14em] text-accent uppercase lg:text-sm">
          {t.bodyCheck.eyebrow}
        </p>
        <h2 class="text-[40px] leading-[0.95] font-semibold tracking-[-0.045em] lg:text-[60px]">
          {t.bodyCheck.title}
        </h2>
        <p class="text-base leading-normal text-mist lg:max-w-[400px] lg:text-lg">
          {t.bodyCheck.text}
        </p>
      </div>
      <div class="relative grid gap-7 sm:grid-cols-2 sm:gap-4">
        <div class="absolute top-1/2 left-1/2 z-10 hidden size-14 -translate-1/2 items-center justify-center rounded-full bg-accent shadow-[0_0_0_6px_var(--color-ink)] sm:flex lg:top-[220px]">
          <svg width="22" height="18" viewBox="0 0 22 18" aria-hidden="true">
            <path
              d="M2 9h17M12 2l7 7-7 7"
              stroke="#0A0A0A"
              stroke-width="2.6"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </div>
        <figure class="flex flex-col gap-2.5 lg:gap-3">
          <div class="h-[340px] overflow-hidden rounded-[20px] lg:h-[440px] lg:rounded-3xl">
            <Image
              src={before}
              alt={t.bodyCheck.before.alt}
              widths={[400, 700, 941]}
              sizes="(min-width: 1024px) 336px, (min-width: 640px) 45vw, 100vw"
              class="size-full object-cover object-[50%_25%] grayscale"
            />
          </div>
          <figcaption class="flex justify-between px-1 text-sm text-subtle lg:px-0">
            <span>{t.bodyCheck.before.label}</span>
            <span class="font-semibold text-paper">{t.bodyCheck.before.weight}</span>
          </figcaption>
        </figure>
        <div class="-my-3.5 flex justify-center sm:hidden" aria-hidden="true">
          <div class="flex size-11 rotate-90 items-center justify-center rounded-full bg-accent">
            <svg width="18" height="15" viewBox="0 0 22 18">
              <path
                d="M2 9h17M12 2l7 7-7 7"
                stroke="#0A0A0A"
                stroke-width="2.6"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </div>
        </div>
        <figure class="flex flex-col gap-2.5 lg:gap-3">
          <div class="h-[340px] overflow-hidden rounded-[20px] shadow-[inset_0_0_0_2px_var(--color-accent)] lg:h-[440px] lg:rounded-3xl">
            <Image
              src={after}
              alt={t.bodyCheck.after.alt}
              widths={[400, 700, 941]}
              sizes="(min-width: 1024px) 336px, (min-width: 640px) 45vw, 100vw"
              class="size-full object-cover object-[50%_25%]"
            />
          </div>
          <figcaption class="flex justify-between px-1 text-sm text-subtle lg:px-0">
            <span>{t.bodyCheck.after.label}</span>
            <span class="font-semibold text-accent">{t.bodyCheck.after.weight}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="flex flex-col items-stretch gap-6 px-6 py-20 text-center sm:items-center lg:gap-7 lg:px-16 lg:py-[120px]">
      <h2 class="break-words text-[44px] leading-[0.95] font-semibold tracking-[-0.05em] sm:text-6xl lg:text-7xl">
        {t.closing}
      </h2>
      <StoreButton class="h-[54px] px-7 text-base lg:h-14">{t.nav.download}</StoreButton>
    </section>
  </main>
</Layout>

<style>
  /* Three phones fanned out: the workout in front, the plan and the history tilted behind it. */
  .fan {
    position: relative;
    height: 420px;
    margin-top: 16px;
    --side: 270px;
    --center: 350px;
    --side-top: 70px;
    --center-top: 24px;
    --spread: 101px;
  }
  .fan > :global(.phone) {
    position: absolute;
    left: 50%;
    filter: drop-shadow(0 16px 28px rgb(0 0 0 / 0.18));
  }
  .fan > :global(.fan-left),
  .fan > :global(.fan-right) {
    --h: var(--side);
    top: var(--side-top);
  }
  .fan > :global(.fan-left) {
    translate: calc(-50% - var(--spread)) 0;
    rotate: -8deg;
  }
  .fan > :global(.fan-right) {
    translate: calc(-50% + var(--spread)) 0;
    rotate: 8deg;
  }
  .fan > :global(.fan-center) {
    --h: var(--center);
    top: var(--center-top);
    translate: -50% 0;
    filter: drop-shadow(0 24px 44px rgb(0 0 0 / 0.28));
  }

  @media (min-width: 40rem) {
    .fan {
      height: 540px;
      --side: 380px;
      --center: 460px;
      --side-top: 90px;
      --center-top: 30px;
      --spread: 130px;
    }
  }

  @media (min-width: 64rem) {
    .fan {
      height: clamp(600px, 56.25vw, 720px);
      margin-top: 0;
      --side: clamp(440px, 42.2vw, 540px);
      --center: clamp(520px, 50vw, 640px);
      --side-top: 110px;
      --center-top: 40px;
      --spread: 125px;
    }
    .fan > :global(.fan-left),
    .fan > :global(.fan-right) {
      filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.18));
    }
    .fan > :global(.fan-center) {
      filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.28));
    }
  }
</style>
